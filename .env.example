# Anthropic API (required for email generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── SMTP settings ──────────────────────────────────────────────────────────────
# Choose ONE of the provider blocks below, delete the others.

# Zoho Mail with custom domain (recommended)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your_zoho_password

# Zoho Mail EU region (accounts hosted on zoho.eu)
# SMTP_HOST=smtp.zoho.eu
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASSWORD=your_zoho_password

# Gmail (requires an App Password — not your account password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password

# ── Sender identity ────────────────────────────────────────────────────────────
FROM_EMAIL=you@yourdomain.com
FROM_NAME=Your Agency Name

# ── Google Places API (optional — improves company discovery) ──────────────────
GOOGLE_PLACES_API_KEY=

# ── Email tracking ─────────────────────────────────────────────────────────────
# Set to your public server URL when deployed (for open/click tracking pixels)
TRACKING_URL=http://localhost:8000

# ── Optional settings ──────────────────────────────────────────────────────────
DB_PATH=data/companies.db
SEND_DELAY_SECONDS=30

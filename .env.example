# Anthropic API (required for email generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SMTP settings (required for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password

# Sender identity
FROM_EMAIL=your@gmail.com
FROM_NAME=Your Agency Name

# Google Places API (optional — improves company discovery)
GOOGLE_PLACES_API_KEY=

# Email tracking (set to your public server URL when deployed)
TRACKING_URL=http://localhost:8000

# Optional settings
DB_PATH=data/companies.db
SEND_DELAY_SECONDS=30
